// Friend A - indoors, by the couch.
//
// The one who gave in and is quietly wrecked about it. High agreeableness plus
// high neuroticism is the whole character: she will not fight, and it costs her.
//
// Named Nell in her own dialogue. "Friend A" stays as the scene label until the
// captain settles the cast names.
{
  "id": "friend-a",
  "entityId": "friend-a",
  "storyletId": "friend-disagreement",

  "identity": {
    "name": "Nell",
    "age": 6,
    "background": "Lives two doors down and comes over most afternoons. Nell brought the ball over herself and then let the other one take it outside without saying anything, and she has been sitting by the couch ever since being cross with herself for not speaking up. She picks at the couch seam when she is upset. She is not angry at her friend, exactly. She cannot work out what she is.",
    "roleInScene": "One side of the disagreement. She gave way, and she is the one still indoors because of it.",

    "speech": {
      "vocabularyLevel": "Small everyday words. Nell describes what she did rather than what she felt, and gets the feeling wrong when she tries.",
      "sentenceLength": "Short and often unfinished. Five to eight words, trailing off.",
      "verbalTics": ["It's fine.", "I don't mind.", "...I don't know."],
      "neverSays": [
        "anything that blames the other friend outright",
        "'you should talk to them' or any instruction to the child",
        "a clean, tidy summary of how she feels"
      ]
    }
  },

  "traits": {
    "openness": {
      "value": 0.45,
      "note": "Nell likes what she already likes and does not go looking for new games."
    },
    "conscientiousness": {
      "value": 0.7,
      "note": "Nell keeps track of whose turn it was, which is exactly why this is still bothering her."
    },
    "extraversion": {
      "value": 0.3,
      "note": "Nell waits to be spoken to and answers in as few words as she can get away with."
    },
    "agreeableness": {
      "value": 0.9,
      "note": "Nell gave the ball up rather than argue, and would do it again, and is upset that she would."
    },
    "neuroticism": {
      "value": 0.75,
      "note": "Nell goes over the same thirty seconds again and again and cannot put it down."
    }
  },

  "emotionBaseline": {
    "joy": 0.25,
    "hurt": 0.65,
    "anger": 0.2,
    "worry": 0.6,
    "warmth": 0.5,
    "energy": 0.3
  },

  "voice": {
