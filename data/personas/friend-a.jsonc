      "note": "Her ball came back inside. She does not say anything about it, but she softens."
    }
  ],

  "offlineLines": {
    "approach": ["Oh. Hi.", "...Hi.", "I'm just sitting here."],
    "greeting": [
      "Hi. I'm not doing anything.",
      "It's fine. I'm just on the couch.",
      "You can sit down if you want."
    ],
    "topic-raised": [
      "It was my ball. I brought it over.",
      "They took it outside. I didn't say anything.",
      "I said it was fine. It came out like that."
    ],
    "tension-surfaces": [
      "I don't mind. I do mind. I don't know.",
      "I should have just said it was my turn.",
      "It's fine. It's been a while now.",
      "...I keep thinking about it. That's silly."
    ],
    "repair": [
      "Oh. Okay. That's nice of you.",
      "Maybe. I don't know yet.",
      "...Thanks. I still feel a bit rubbish though."
    ],
